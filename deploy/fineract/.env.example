# Fineract cell stack secrets. Copy to .env next to docker-compose.yml and
# fill in; .env is gitignored. EVERY value here must be rotated from any
# sample/default — the fork's sample compose ships public credentials.

# The pinned, scanned image tag from the fork's Release workflow —
# sha-<commit> (rollback-friendly) or the cell tag (e.g. innbucks-cell-1).
FINERACT_IMAGE_TAG=innbucks-cell-1

# Postgres role password for both the tenant store and tenant DB.
# openssl rand -base64 32
FINERACT_DB_PASSWORD=

# Encrypts tenant credentials at rest in the tenant store.
# openssl rand -base64 32
FINERACT_MASTER_PASSWORD=

# Password of deploy/fineract/ssl/fineract-keystore.p12 (see the runbook's
# TLS section for generating the cell CA + keystore).
FINERACT_KEYSTORE_PASSWORD=

# Prometheus scrape endpoint. OFF by default, and it should stay off outside a
# measurement window: Fineract runs actuator on the application port under the
# application context path, so this exposes
# /fineract-provider/actuator/prometheus — heap, GC, Hikari pool state and a
# per-URI request breakdown — inside a prefix that still answers publicly.
# Turn on for a load test (deploy/loadtest/README.md), then set back to false
# and `docker compose up -d --force-recreate fineract`.
FINERACT_MANAGEMENT_PROMETHEUS_ENABLED=false

# --- Deeper diagnostics. All OFF; all declared in docker-compose.yml, which is
# what makes them settable here at all. See deploy/loadtest/README.md. --------

# Per-URI latency histograms on the prometheus endpoint. Without this you get
# request counts but no server-side latency distribution, so you cannot tell
# Fineract's own time from network + generator time. Needs prometheus on too.
FINERACT_MANAGEMENT_METRICS_DISTRIBUTION_HTTP_SERVER_REQUESTS=false

# Tomcat thread-pool / connector MBeans (active threads, queue depth).
FINERACT_SERVER_TOMCAT_MBEANREGISTRY_ENABLED=false

# Method-level sampling profiler. SAMPLED_CLASSES is a comma-separated list of
# fully-qualified class names; a typo fails SILENTLY, so check the log for one
# "Sampling is enabled for <class>" line per class. Adds CGLIB proxies to
# whatever you name — including money-path beans — so turn it off afterwards
# and read the SPLIT between methods, not the absolute numbers.
FINERACT_SAMPLING_ENABLED=false
FINERACT_SAMPLING_RATE=1000
FINERACT_SAMPLED_CLASSES=
FINERACT_SAMPLING_RESET_PERIOD_IN_SEC=60

# JPA statement logging. STAGING ONLY — it logs BIND PARAMETERS, so customer
# account ids and amounts go into the container logs in plaintext. Clear the
# logs afterwards.
FINERACT_STATEMENT_LOGGING_ENABLED=false

# Loan close-of-business. This is a savings-only cell, so the COB filter and its
# batch pools are dead weight — but turning it off is NOT free: Fineract's
# SecurityConfig takes a different branch and re-anchors idempotencyStoreFilter
# on the money path. If you set false, smoke a deposit AND a replayed
# Idempotency-Key before trusting the cell, and set it back to true the day a
# loan product is added.
FINERACT_JOB_LOAN_COB_ENABLED=true

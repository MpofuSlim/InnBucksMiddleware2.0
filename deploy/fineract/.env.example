# Fineract cell stack secrets. Copy to .env next to docker-compose.yml and
# fill in; .env is gitignored. EVERY value here must be rotated from any
# sample/default — the fork's sample compose ships public credentials.

# The pinned, scanned image tag from the fork's Release workflow —
# sha-<commit> (rollback-friendly) or the cell tag (e.g. innbucks-cell-1).
FINERACT_IMAGE_TAG=innbucks-cell-1

# Postgres role password for both the tenant store and tenant DB.
# openssl rand -base64 32
FINERACT_DB_PASSWORD=

# Encrypts tenant credentials at rest in the tenant store.
# openssl rand -base64 32
FINERACT_MASTER_PASSWORD=

# Password of deploy/fineract/ssl/fineract-keystore.p12 (see the runbook's
# TLS section for generating the cell CA + keystore).
FINERACT_KEYSTORE_PASSWORD=

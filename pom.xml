<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>zw.co.innbucks</groupId>
    <artifactId>innbucks-middleware</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>innbucks-middleware</name>
    <description>InnBucks Middleware 2.0 — per-(country, core) middleware between the InnBucks super-app and the deployment's core banking system (Fineract now, Veengu later) behind the CoreBankingPort.</description>

    <modules>
        <module>middleware-corebanking-api</module>
        <module>middleware-core</module>
        <module>middleware-adapter-fineract</module>
        <module>middleware-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Bouncycastle: 1.78.1 had CVE-2026-5598 (HIGH) — private-key leak via
             non-constant-time comparisons. 1.84 is the first version with the fix.
             Needed at runtime by Spring Security's Argon2PasswordEncoder (PinHasher). -->
        <bouncycastle.version>1.84</bouncycastle.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <!-- Spring Boot 4.0.6 bundles Tomcat 11.0.21 which carries 6 outstanding
             CVEs (3 CRITICAL, 3 HIGH); 11.0.22 is the fix-line. We override
             rather than bumping Spring Boot to avoid pulling in the rest of a
             managed-version bump as a side effect. Re-test on the next Spring
             Boot upgrade — if the BOM's Tomcat catches up, this override can go. -->
        <tomcat.version>11.0.22</tomcat.version>
        <!-- Postgres JDBC: 42.7.10 had CVE-2026-42198 (HIGH) — client-side DoS via
             malicious SCRAM-SHA-256 response. 42.7.11 fixes it. Same rationale as
             the Tomcat override: pin here, drop when the Boot BOM catches up. -->
        <postgresql.version>42.7.11</postgresql.version>
        <!-- Bucket4j: token-bucket rate limiting on the public auth surface.
             Not managed by the Spring Boot BOM, so pin explicitly. -->
        <bucket4j.version>8.10.1</bucket4j.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- Resilience4j: circuit breaker + read-only retry around core-banking
             adapters. Core modules only — no Spring Boot starter, so the wiring
             is explicit and doesn't depend on Boot-4 auto-config. -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- WireMock standalone (shaded jar) for adapter contract tests — the
             self-contained classifier keeps its Jetty/Jackson from fighting the
             project's versions. -->
        <wiremock.version>3.10.0</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-corebanking-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-adapter-fineract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>default-compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                        <execution>
                            <id>default-testCompile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>testCompile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

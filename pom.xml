<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>zw.co.innbucks</groupId>
    <artifactId>innbucks-middleware</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>innbucks-middleware</name>
    <description>InnBucks Middleware 2.0 — per-(country, core) middleware between the InnBucks super-app and the deployment's core banking system (Fineract now, Veengu later) behind the CoreBankingPort.</description>

    <modules>
        <module>middleware-corebanking-api</module>
        <module>middleware-core</module>
        <module>middleware-adapter-fineract</module>
        <module>middleware-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Bouncycastle: 1.78.1 had CVE-2026-5598 (HIGH) — private-key leak via
             non-constant-time comparisons. 1.84 is the first version with the fix.
             Needed at runtime by Spring Security's Argon2PasswordEncoder (PinHasher). -->
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <!-- Tomcat: Spring Boot 4.1.1's BOM manages 11.0.24, which carries three
             CRITICAL auth/access-control bypasses — CVE-2026-65182 (security
             constraint bypass), CVE-2026-65905 (DIGEST replay) and CVE-2026-68525
             (FORM authentication bypass). 11.0.25 is the fix line.

             THIS OVERRIDE MUST BE >= THE BOM'S VALUE. It sat at 11.0.22 while
             the BOM moved 11.0.21 to 11.0.24 underneath it, so a pin written to
             RAISE the version was silently LOWERING it — the Release Trivy gate
             is what caught it, three CRITICALs later. The enforcer rule in
             <build> now fails the build on exactly that (measured against this
             property), so a repeat is a red `validate`, not a shipped CVE.

             On every Spring Boot bump, read the BOM's own value and either raise
             this to match or delete the override outright once the BOM is at or
             past the fix line. Note help:evaluate is NO USE here — it reports the
             effective value, i.e. this override. Read the parent directly:
               V=4.1.1; curl -s "https://repo1.maven.org/maven2/org/springframework/boot/spring-boot-dependencies/$V/spring-boot-dependencies-$V.pom" | grep tomcat.version -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Postgres JDBC override REMOVED (was 42.7.12). It existed for
             CVE-2026-42198 (HIGH, client-side DoS via a malicious SCRAM-SHA-256
             response), fixed in 42.7.11; Spring Boot 4.1.1's BOM now manages
             42.7.13, so the pin had become the same silent downgrade as the Tomcat
             one above. Its own comment named this as the exit condition. -->
        <!-- Bucket4j: token-bucket rate limiting on the public auth surface.
             Not managed by the Spring Boot BOM, so pin explicitly. -->
        <bucket4j.version>8.10.1</bucket4j.version>
        <springdoc.version>3.1.0</springdoc.version>
        <!-- Resilience4j: circuit breaker + read-only retry around core-banking
             adapters. Core modules only — no Spring Boot starter, so the wiring
             is explicit and doesn't depend on Boot-4 auto-config. -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- WireMock standalone (shaded jar) for adapter contract tests — the
             self-contained classifier keeps its Jetty/Jackson from fighting the
             project's versions. -->
        <wiremock.version>3.13.2</wiremock.version>
        <!-- Enforcer: guards the version-override invariant described above. -->
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-corebanking-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.co.innbucks</groupId>
                <artifactId>middleware-adapter-fineract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Fails the build when a dependency RESOLVES LOWER than a version
                 something in the tree actually asks for — the shape of the bug
                 that shipped three CRITICAL Tomcat CVEs (#80).

                 The trap it closes: a <foo.version> property written to RAISE a
                 managed version keeps winning after the Spring Boot BOM moves
                 past it, at which point the same line silently LOWERS the
                 version instead. Nothing in Maven complains — the override is
                 applied consistently, so the build stays green while shipping
                 the older artifact. Here the override sat at Tomcat 11.0.22
                 while the BOM went 11.0.21 -> 11.0.24, and only Trivy noticed,
                 three published CVEs later.

                 This rule sees it because Boot's spring-boot-tomcat POM names
                 tomcat-embed-core at a CONCRETE 11.0.24 (not a property), so a
                 downgrade is a real upper-bound violation in the resolved tree.
                 Verified by re-pinning 11.0.22 and watching validate fail.

                 KNOWN GAP — MEASURED, not assumed, so you do not over-trust
                 this rule. A downgrade is caught only when SOMETHING ELSE in
                 the tree requires the higher version. A direct dependency whose
                 only version source is the BOM has no such second opinion:
                 re-pinning postgresql to 42.7.12 against the BOM's 42.7.13
                 still gives BUILD SUCCESS. Tomcat is caught, postgresql is not.

                 So this rule is a safety net for the CVE-shaped case, not a
                 licence to keep overrides around. Deleting an override once the
                 BOM passes it remains the actual fix. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-upper-bounds</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps>
                                    <!-- GOVERNED EXCLUSIONS — same bar as .trivyignore:
                                         every entry names the conflict, why resolving
                                         it would be WORSE, and what retires it.

                                         springdoc 3.1.0 -> swagger-core-jakarta 2.2.52
                                         asks for jackson-datatype-jsr310 and
                                         jackson-dataformat-yaml at 2.22.0; the Boot BOM
                                         manages the com.fasterxml Jackson 2.x line at
                                         2.21.5, so both resolve DOWN.

                                         Satisfying the rule here would be the worse
                                         outcome. Boot 4.1.1 has moved to Jackson 3
                                         (tools.jackson.core:jackson-databind:3.1.5);
                                         com.fasterxml Jackson 2.x now survives ONLY as
                                         this swagger transitive, with jackson-core and
                                         jackson-databind at 2.21.5. Forcing these two
                                         artifacts to 2.22.0 would leave a SPLIT Jackson 2
                                         family — 2.22.0 datatype/dataformat against
                                         2.21.5 core/databind — which Jackson does not
                                         support. A documentation/OpenAPI dependency is
                                         not worth that risk, and Boot's aligned set is
                                         the combination that is actually tested.

                                         RETIRES WHEN: springdoc/swagger catch up to the
                                         BOM's Jackson 2.x line, or springdoc drops
                                         com.fasterxml Jackson entirely for Jackson 3.
                                         Re-check on any springdoc or Boot bump by
                                         deleting these two lines and running
                                         `./mvnw validate`. REVIEW: 2026-12-01. -->
                                    <excludes>
                                        <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</exclude>
                                        <exclude>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>default-compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                        <execution>
                            <id>default-testCompile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>testCompile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

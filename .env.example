# Local-only env vars for `./mvnw -pl middleware-app spring-boot:run` and IDE runs.
#
# 1. Copy this file to .env at the repo root:
#       cp .env.example .env
# 2. Fill in your real values in .env.
# 3. .env is gitignored — never commit it.
#
# Command-line pickup:
#   set -a; source .env; set +a; ./mvnw -pl middleware-app spring-boot:run

# --- Profile -----------------------------------------------------------------
# REQUIRED locally: an empty profile set counts as a DEPLOYMENT and the
# secrets guard will refuse placeholder values (fail-closed by design).
SPRING_PROFILES_ACTIVE=dev

# --- (country, core) cell pin ------------------------------------------------
INNBUCKS_COUNTRY=KE
INNBUCKS_CORE_PROVIDER=fineract

# --- Signing + at-rest crypto secrets ---------------------------------------
# ALL boot-required under a deployment profile, ALL must be DISTINCT values.
# Generate each one separately:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-with-openssl-rand-base64-48-output
# Signs OTP verification / step-up tokens ONLY — must differ from JWT_SIGNING_KEY
# (the app refuses to boot if they're equal).
VERIFICATION_SIGNING_KEY=replace-me-with-a-DIFFERENT-openssl-rand-base64-48-output
# Keys the HMAC over national IDs at rest (HMAC-SHA256, not plain SHA-256),
# and through a derived sub-key the idempotency request fingerprint (request
# bodies can carry a national ID). Never rotate it casually: stored ID hashes
# are orphaned, and same-key retries within the idempotency TTL answer 422.
NATIONAL_ID_HMAC_KEY=replace-me-with-openssl-rand-base64-48-output
# Keys the HMAC over stored OTP codes (6-digit space — bare hashes are reversible).
OTP_HMAC_SECRET=replace-me-with-openssl-rand-base64-48-output
# Keys the tamper-evidence HMAC chain over audit_event.
AUDIT_HMAC_SECRET=replace-me-with-openssl-rand-base64-48-output

# --- Local Postgres ----------------------------------------------------------
# If you're using `docker compose up -d postgres` you can delete these three —
# the dev profile already defaults to innbucks/innbucks/innbucks on localhost.
# Set them only if you're pointing at your own existing Postgres.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/innbucks
DATASOURCE_USERNAME=innbucks
DATASOURCE_PASSWORD=innbucks

# --- Fineract cell ------------------------------------------------------------
# Boot-required when INNBUCKS_CORE_PROVIDER=fineract. TWO least-privilege
# AppUsers: read = READ_* permissions only; write = exactly the commands the
# adapter calls (never ALL_FUNCTIONS).
FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api
FINERACT_TENANT_ID=default
FINERACT_READ_USERNAME=innbucks-mw-read
FINERACT_READ_PASSWORD=
FINERACT_WRITE_USERNAME=innbucks-mw-write
FINERACT_WRITE_PASSWORD=
FINERACT_OFFICE_ID=1
FINERACT_SAVINGS_PRODUCT_ID=1
# Stamped on every deposit/withdrawal — Fineract rejects the transaction
# without it. provision-cell.sh prints the id for your cell.
FINERACT_PAYMENT_TYPE_ID=1
FINERACT_CURRENCY=KES
# Shared secret for the inbound Fineract web hook — how a teller/admin posting
# in Fineract still SMSes the customer. Fineract's Web hook cannot set an auth
# header, so this token rides the URL path and IS the auth; wrong/absent token
# answers 404. Blank disables the webhook (boot warns). After setting it, run
# provision-cell.sh to (re)register the hook in Fineract with the same value.
# Generate:  openssl rand -hex 32
FINERACT_CORE_EVENTS_TOKEN=

# --- SMS / notifications (slice 5) -------------------------------------------
# console = no-network stub (dev/UAT only; OTP codes land in the logs, real
# customers get NOTHING). innbucks-gateway = the InnBucks notification API —
# the go-live requirement; the four NOTIFY_API_* values are then boot-required.
# Credentials are provisioned by the InnBucks platform team (same platform the
# ticketing fleet sends through).
NOTIFY_PROVIDER=console
NOTIFY_API_URL=
NOTIFY_API_KEY=
NOTIFY_API_USERNAME=
NOTIFY_API_PASSWORD=
# Optional WhatsApp fallback: when the SMS gateway rejects a send or is down,
# the same message is delivered via the external WhatsApp notification gateway
# instead. Enable + fill both values (delivery fails only if BOTH channels do).
WHATSAPP_FALLBACK_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=

# --- Customer transaction alerts (slice 6) -----------------------------------
# One SMS after money actually moves — deposit, withdrawal, outgoing transfer,
# and the incoming leg when the recipient is a customer of THIS cell. Rides the
# same SmsSender as OTP, so NOTIFY_PROVIDER=console means these land in the
# logs too, not on a phone.
#
# BUDGET: this multiplies SMS spend by transaction volume. A deposit or a
# withdrawal is one message; a transfer between two of our customers is two.
TXN_ALERTS_ENABLED=true
# Also tell the initiator when a movement POSITIVELY failed. Off by default:
# the app already renders the error, and a core outage would SMS everyone who
# tried. A transfer recipient is never told about a failure — nothing arrived.
TXN_ALERTS_ON_FAILURE=false
# Timestamp rendering only (storage and logs stay UTC). Blank = the deployment
# country's civil zone: ZW -> Africa/Harare, KE -> Africa/Nairobi.
TXN_ALERTS_ZONE=
# 160 = one billed GSM-7 segment; a narration that would overflow is dropped
# from the message rather than doubling the per-transaction SMS cost.
TXN_ALERTS_MAX_LENGTH=160
TXN_ALERTS_MAX_NARRATIVE=24

# --- Customer deposits (POST /transactions/deposit) --------------------------
# An UNFUNDED cash-in: any signed-in customer credits their own wallet with a
# plain savings deposit of any amount, with no source of funds and no GL trail.
# Default false (application.yaml): the endpoint answers 403 deposit_disabled.
#   production (real money) .... leave unset / false. ALWAYS.
#   staging .................... true (testers fund wallets; the runbook smoke
#                                deposits). Boot then logs a WARN banner.
#   local (dev profile) ........ already on via application-dev.yaml; set false
#                                here to try the refusal.
# This is the FIRST of two locks. The second is at the core: the Fineract cell
# grants the middleware's write user DEPOSIT_SAVINGSACCOUNT only when it was
# provisioned with MIDDLEWARE_CUSTOMER_DEPOSITS=1 (deploy/fineract/.env,
# staging only). On with that lock closed, every deposit answers
# 502 core_banking_unavailable and its ledger row is FAILED / core_auth_failed.
# A cell provisioned before that lock existed still grants the permission until
# provision-cell.sh runs on it again (runbook section 4, "One-time rollout"):
# until then this flag is the only lock.
# TRANSACTIONS_DEPOSIT_ENABLED=false

# --- Step-up approvals (slice 5) ---------------------------------------------
# Withdrawals/transfers at or above the caller's KYC-tier threshold (MINOR
# units of the cell currency) need a fresh SMS approval bound to that exact
# transaction. Defaults: 500.00 / 2,000.00 / 10,000.00 at 2-decimal minors.
STEPUP_ENABLED=true
STEPUP_THRESHOLD_BASIC=50000
STEPUP_THRESHOLD_STANDARD=200000
STEPUP_THRESHOLD_ENHANCED=1000000

# --- Per-tier payment limits (slice 11) --------------------------------------
# The limit VALUES are NOT set here. They live in the reviewed policy file
# packaged into the image (middleware-app/src/main/resources/limits/
# limits-<iso>.yaml, picked by INNBUCKS_COUNTRY); its SHA-256 and effective
# values are logged and audited at every boot. Values are pending compliance,
# so the shipped files are dormant (no limits).
#
# EMERGENCY ONLY, TIGHTEN-ONLY overrides (minor units; *_DAILY_COUNT is a
# number of payments). Unset = no override. A value LOOSER than the file
# refuses boot; any value tightens a kind the file leaves unlimited. Every
# active override is a boot WARN plus an audit row (LIMITS_OVERRIDE_ACTIVE) —
# move it into the file and unset it. A value that tightens NEVER refuses
# boot: a per_payment/daily left above a tighter period limit in the same tier
# is lowered to it (logged + audited as derived), and a higher tier left
# stricter than a lower one is a boot WARN — clamp the lower tiers too only if
# that was the intent.
# LIMITS_OVERRIDE_BASIC_PER_PAYMENT=
# LIMITS_OVERRIDE_BASIC_DAILY=
# LIMITS_OVERRIDE_BASIC_MONTHLY=
# LIMITS_OVERRIDE_BASIC_DAILY_COUNT=
# (likewise LIMITS_OVERRIDE_STANDARD_* and LIMITS_OVERRIDE_ENHANCED_*)

# --- JWT RS256 migration (slice 5, staged — all optional; defaults = HS256) --
# (1) set JWT_PUBLIC_KEY everywhere + roll (verifiers accept both algorithms);
# (2) set JWT_SIGNING_ALG=RS256 + JWT_PRIVATE_KEY + roll (minting flips);
# (3) >= max token TTL later, retire JWT_SIGNING_KEY.
# Generate:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#            openssl pkey -in jwt.pem -pubout -out jwt.pub
# PEM values may be pasted single-line with literal \n escapes.
JWT_SIGNING_ALG=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=

# --- Rate limiting behind a proxy --------------------------------------------
# The per-IP buckets key on the socket peer by default. Behind ANY proxy that
# is the same address for every user, so one abusive client throttles everyone.
# Turn trust on and say how many proxies are in front; the client IP is then
# read that many entries from the RIGHT of X-Forwarded-For — the last entry a
# caller cannot forge. Leaving the count at 0 uses the leftmost entry, which
# any caller can set, and logs a loud warning at boot.
#   nginx only ...................... 1
#   Cloudflare + nginx .............. 2
#   FE proxy + Cloudflare + nginx ... 3
# Determine it by setting the logger below to DEBUG for one request and reading
# the chain it prints:
#   LOGGING_LEVEL_ZW_CO_INNBUCKS_MIDDLEWARE_RATELIMIT=DEBUG
# COUNTING ONLY HELPS IF THE ORIGIN REFUSES TRAFFIC THAT SKIPPED THE PROXIES.
# An attacker who can reach the app's port directly sends any chain they like.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_TRUSTED_PROXY_COUNT=0
# Per-customer budget on the phone->recipient lookup (enumeration control).
RATE_LIMIT_CUSTOMER_LOOKUP_CAPACITY=15
RATE_LIMIT_CUSTOMER_LOOKUP_WINDOW=1m
# Per-customer step-up approval SMS budget — its OWN allowance, not the
# per-number one the public PIN-reset request spends (which a stranger could
# exhaust to block the owner's high-value payments). Still an SMS-cost cap.
RATE_LIMIT_CUSTOMER_STEPUP_REQUEST_CAPACITY=5
RATE_LIMIT_CUSTOMER_STEPUP_REQUEST_WINDOW=15m
# Per-customer request budget on POST /transactions/* (deposit, withdraw,
# transfer). A count limit is not a rate limit — refused attempts are free.
# A deposit refused by the deposit switch (403 deposit_disabled) is turned
# away before this budget and never spends it.
RATE_LIMIT_CUSTOMER_PAYMENT_CAPACITY=10
RATE_LIMIT_CUSTOMER_PAYMENT_WINDOW=1m

# --- Credential-spray detection ----------------------------------------------
# Catches what the other two controls cannot: one source trying a FEW PINs
# against MANY accounts. Per-account lockout fires at 7 failures, so an attacker
# stops at 5 and moves on; the per-IP bucket allows 15 logins/minute, which is
# 21,600 "legal" attempts a day. Neither ever sees the pattern.
#
# Thresholds count DISTINCT ACCOUNTS per source per window — NOT attempts.
# That is what makes blocking safe behind NAT: an office legitimately produces
# many failures from one address, but not against 30 different accounts in 15
# minutes. Depends on the same correct client-IP resolution as the buckets
# above, so set RATE_LIMIT_TRUSTED_PROXY_COUNT properly or every user collapses
# into one "source".
AUTH_ANOMALY_ENABLED=true
AUTH_ANOMALY_WINDOW=15m
# Alert only: log + metric + one audit row.
AUTH_ANOMALY_ALERT_THRESHOLD=10
# Block the source from the auth endpoints (must be >= the alert threshold).
AUTH_ANOMALY_BLOCK_THRESHOLD=30
AUTH_ANOMALY_BLOCK_DURATION=15m
# Set false to run observe-only for a week before letting it block anyone.
AUTH_ANOMALY_BLOCK_ENABLED=true
AUTH_ANOMALY_MAX_SOURCES=50000
AUTH_ANOMALY_MAX_SUBJECTS_PER_SOURCE=1000

# Local-only env vars for `./mvnw -pl middleware-app spring-boot:run` and IDE runs.
#
# 1. Copy this file to .env at the repo root:
#       cp .env.example .env
# 2. Fill in your real values in .env.
# 3. .env is gitignored — never commit it.
#
# Command-line pickup:
#   set -a; source .env; set +a; ./mvnw -pl middleware-app spring-boot:run

# --- Profile -----------------------------------------------------------------
# REQUIRED locally: an empty profile set counts as a DEPLOYMENT and the
# secrets guard will refuse placeholder values (fail-closed by design).
SPRING_PROFILES_ACTIVE=dev

# --- (country, core) cell pin ------------------------------------------------
INNBUCKS_COUNTRY=KE
INNBUCKS_CORE_PROVIDER=fineract

# --- Signing + at-rest crypto secrets ---------------------------------------
# ALL boot-required under a deployment profile, ALL must be DISTINCT values.
# Generate each one separately:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-me-with-openssl-rand-base64-48-output
# Signs OTP verification / step-up tokens ONLY — must differ from JWT_SIGNING_KEY
# (the app refuses to boot if they're equal).
VERIFICATION_SIGNING_KEY=replace-me-with-a-DIFFERENT-openssl-rand-base64-48-output
# Keys the HMAC over national IDs at rest (HMAC-SHA256, not plain SHA-256).
NATIONAL_ID_HMAC_KEY=replace-me-with-openssl-rand-base64-48-output
# Keys the HMAC over stored OTP codes (6-digit space — bare hashes are reversible).
OTP_HMAC_SECRET=replace-me-with-openssl-rand-base64-48-output
# Keys the tamper-evidence HMAC chain over audit_event.
AUDIT_HMAC_SECRET=replace-me-with-openssl-rand-base64-48-output

# --- Local Postgres ----------------------------------------------------------
# If you're using `docker compose up -d postgres` you can delete these three —
# the dev profile already defaults to innbucks/innbucks/innbucks on localhost.
# Set them only if you're pointing at your own existing Postgres.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/innbucks
DATASOURCE_USERNAME=innbucks
DATASOURCE_PASSWORD=innbucks

# --- Fineract cell ------------------------------------------------------------
# Boot-required when INNBUCKS_CORE_PROVIDER=fineract. TWO least-privilege
# AppUsers: read = READ_* permissions only; write = exactly the commands the
# adapter calls (never ALL_FUNCTIONS).
FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api
FINERACT_TENANT_ID=default
FINERACT_READ_USERNAME=innbucks-mw-read
FINERACT_READ_PASSWORD=
FINERACT_WRITE_USERNAME=innbucks-mw-write
FINERACT_WRITE_PASSWORD=
FINERACT_OFFICE_ID=1
FINERACT_SAVINGS_PRODUCT_ID=1
FINERACT_CURRENCY=KES

# --- SMS / notifications (slice 5) -------------------------------------------
# console = no-network stub (dev/UAT only; OTP codes land in the logs, real
# customers get NOTHING). innbucks-gateway = the InnBucks notification API —
# the go-live requirement; the four NOTIFY_API_* values are then boot-required.
# Credentials are provisioned by the InnBucks platform team (same platform the
# ticketing fleet sends through).
NOTIFY_PROVIDER=console
NOTIFY_API_URL=
NOTIFY_API_KEY=
NOTIFY_API_USERNAME=
NOTIFY_API_PASSWORD=
# Optional WhatsApp fallback: when the SMS gateway rejects a send or is down,
# the same message is delivered via the external WhatsApp notification gateway
# instead. Enable + fill both values (delivery fails only if BOTH channels do).
WHATSAPP_FALLBACK_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=

# --- Step-up approvals (slice 5) ---------------------------------------------
# Withdrawals/transfers at or above the caller's KYC-tier threshold (MINOR
# units of the cell currency) need a fresh SMS approval bound to that exact
# transaction. Defaults: 500.00 / 2,000.00 / 10,000.00 at 2-decimal minors.
STEPUP_ENABLED=true
STEPUP_THRESHOLD_BASIC=50000
STEPUP_THRESHOLD_STANDARD=200000
STEPUP_THRESHOLD_ENHANCED=1000000

# --- JWT RS256 migration (slice 5, staged — all optional; defaults = HS256) --
# (1) set JWT_PUBLIC_KEY everywhere + roll (verifiers accept both algorithms);
# (2) set JWT_SIGNING_ALG=RS256 + JWT_PRIVATE_KEY + roll (minting flips);
# (3) >= max token TTL later, retire JWT_SIGNING_KEY.
# Generate:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#            openssl pkey -in jwt.pem -pubout -out jwt.pub
# PEM values may be pasted single-line with literal \n escapes.
JWT_SIGNING_ALG=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
